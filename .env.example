# ============================================================
#  ARES CODE — конфигурация
#  Скопируй этот файл в .env и заполни реальные значения.
#  .env НИКОГДА не попадает в архив/репозиторий.
# ============================================================

# --- Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=123456789:PUT_YOUR_BOT_TOKEN_HERE
# Telegram ID владельцев через запятую (узнать свой: /id у бота)
OWNER_TELEGRAM_IDS=
# HTTPS-адрес Mini App (например https://xxx.example.com). Без него кнопки WebApp не будет
BASE_URL=

# --- LLM failover: GLM-4.7-Flash -> Gemini Flash -> OpenRouter :free -> OmniRoute ---
GLM_API_KEY=PUT_GLM_KEY
GLM_API_BASE=https://api.z.ai/api/paas/v4
GLM_MODEL=glm-4.7-flash
# модель для сообщений с картинками
GLM_VISION_MODEL=glm-4.6v-flash
# резерв #2 (~250 запросов/сутки бесплатно)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# резерв #3 (бесплатный пул OpenRouter; openrouter/free = авто-выбор живой бесплатной модели)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACKS=qwen/qwen3-coder:free,nvidia/nemotron-3-ultra-550b-a55b:free
# резерв #4 — OmniRoute (локальный роутер бесплатных пулов, ставится отдельно:
#   npm install -g omniroute  →  дашборд http://localhost:20128 → Endpoints → ключ)
# Пока OMNIROUTE_API_KEY пуст — ступень выключена.
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto

# --- Холодное хранение (почтовые ящики, пароли внешних приложений) ---
COLDSTORE_IMAP_HOST=imap.mail.ru
COLDSTORE_IMAP_PORT=993
COLDSTORE_SMTP_HOST=smtp.mail.ru
COLDSTORE_SMTP_PORT=465
COLDSTORE_EMAIL_1_LOGIN=
COLDSTORE_EMAIL_1_PASS=
COLDSTORE_EMAIL_2_LOGIN=
COLDSTORE_EMAIL_2_PASS=
COLDSTORE_EMAIL_3_LOGIN=
COLDSTORE_EMAIL_3_PASS=
COLDSTORE_EMAIL_4_LOGIN=
COLDSTORE_EMAIL_4_PASS=
# максимальный размер письма (части), МБ
COLDSTORE_MAX_MAIL_MB=20

# --- Токен-экономика (поднятые "удобные" лимиты; меняй под себя) ---
TOK_BUDGET_DAY=1000000
REQ_BUDGET_DAY=1000
WARN_AT=0.8
ECONOMY_AT=0.9
# порог сжатия контекста (оценка в токенах)
CTX_COMPACT_AT=30000

# --- Песочница исполнителя ---
EXEC_TIMEOUT=60
EXEC_MEM_MB=512
EXEC_OUT_MAX_LINES=40
EXEC_WORKERS=2

# --- Сервис и фон ---
# час ежедневной уборки (локальное время сервера)
CLEANUP_HOUR=4
# порог диска для внеплановой уборки (доля)
DISK_CLEAN_AT=0.8
# сколько часов держать файлы в workspace/.trash
TRASH_TTL_H=24
HUD_INTERVAL_S=5
TYPEWRITER_MS=15
PORT=8000
# 1 = бот работает в режиме polling внутри api.py
BOT_POLLING=1
# 1 = РАЗРЕШИТЬ доступ без Telegram-подписи ТОЛЬКО для локальной отладки. На сервере держать 0!
ALLOW_UNAUTH_DEV=0
 
