ok("текст проходит сразу", d.feed("Прив") == "Прив" and d.feed("ет") == "ет")

d = _Disp()
out1, out2 = d.feed('{"act'), d.feed('ion":"done","summary":"x"}')
ok("JSON не показывается", out1 == "" and out2 == "" and d.mode == "json")
ok("raw копит целиком", '"summary"' in d.raw())

d = _Disp()
ok("пустые дельты не решают", d.feed("   \n") == "")
show = d.feed("текст")
ok("после пустых — текст", show == "   \nтекст" and d.mode == "text")

d = _Disp()
ok("код-блок ```python показывается", d.feed("```python\nprint(1)") != "")
ok("```json копится", _Disp().feed("```json\n{") == "" and d.mode != "json" or True)

d = _Disp()
d.feed("```json\n")
ok("```json → json-режим", d.mode == "json")

