# ---------------------------------------------------------------- 4. agent_stream (мок LLM)

print("[4] agent_stream: задача план→write→run→done")


class Script:
    def __init__(self, responses):
        self.resp = list(responses)

    def __call__(self, messages, level="LIGHT", purpose="chat", images=None):
        r = self.resp.pop(0)

        async def gen():
            yield ("provider", "glm:mock")
            yield ("delta", r)
            yield ("usage", (10, 5))

        return gen()


async def collect(script_resp, goal, history=None):
    agent.llm_stream, orig = Script(script_resp), agent.llm_stream
    try:
        evs = []
        async for ev in agent.agent_stream(goal, P, "LIGHT", history=history):
            evs.append(ev)
        return evs
    finally:
        agent.llm_stream = orig


evs = run(collect([
    '{"action":"plan","steps":["написать","запустить"]}',
    '{"action":"write","path":"hello.py","content":"print(2+2)"}',
    '{"action":"run","cmd":"python3 hello.py"}',
    '{"action":"done","summary":"готово: вывело 4"}',
], "посчитай 2+2 в файле"))
types = [e["t"] for e in evs]
ok("план пришёл", "plan" in types)
ok("шаг write", any(e["t"] == "step" and e["kind"] == "write" for e in evs))
run_step = next((e for e in evs if e["t"] == "step" and e["kind"] == "run"), None)
ok("шаг run с выводом", run_step is not None and "4" in (run_step.get("out") or ""))
done = next((e for e in evs if e["t"] == "done"), None)
ok("done с итогом", done is not None and "готово" in done["s"])
ok("нет сырого JSON в дельтах", all("action" not in (e.get("s") or "") for e in evs if e["t"] == "delta"))

hist = []
evs = run(collect(["Готово, файл создан."], "сделай файл", history=hist))
deltas = "".join(e["s"] for e in evs if e["t"] == "delta")
ok("текстовый ответ стримится", "Готово" in deltas)
ok("done пустой для текста", next(e for e in evs if e["t"] == "done")["s"] == "")
ok("история пополнилась", len(hist) == 2 and hist[0]["role"] == "user")

evs = run(collect(['{"note":"пример формата"}'], "покажи пример"))
ok("JSON-без-action показан как текст", any("пример формата" in (e.get("s") or "") for e in evs if e["t"] == "delta"))
ok("нет err в фолбэке", not any(e["t"] == "err" for e in evs))

evs = run(collect(['{"action":"fail","reason":"нет токена"}'], "создай бота"))
ok("fail доходит", any(e["t"] == "fail" and "токена" in e["s"] for e in evs))

